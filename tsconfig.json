{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "lib": [
      "esnext",
      "esnext.array",
      "esnext.asynciterable",
      "esnext.symbol"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "target": "ESNEXT",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "allowJs": true,
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "eslint.config.mjs"
  ]
}